APP_HOST=127.0.0.1
APP_PORT=8443
LOG_LEVEL=INFO

MODEL_BASE_URL=https://your-model-gateway.example.com/v1
MODEL_API_KEY=replace-me
MODEL_NAME=example-model
MODEL_TIMEOUT_SECONDS=180
MODEL_TEMPERATURE=0.2
MODEL_RETRY_STATUS_CODES=503
MODEL_RETRY_INTERVALS_SECONDS=15,20,30,45,60
MODEL_MAX_TOTAL_WAIT_SECONDS=300

# ============================================================
# 模型接口 TLS / SSL
# ============================================================

# 推荐变量：true 校验证书；false 关闭校验，仅用于 POC。
MODEL_VERIFY_SSL=true

# 兼容以下任一旧写法，四者只保留一个即可：
# VERIFY=false
# ENV_VERIFY=false
# ENVVERIFY=false
# envverify=false

# 企业根 CA / 中间 CA / 完整 CA 链，必须为 PEM 格式。
# 相对路径以项目根目录为基准。
# 示例：MODEL_CA_BUNDLE=certs/company-ca-bundle.pem
MODEL_CA_BUNDLE=

# ============================================================
# 可选 mTLS 客户端认证
# ============================================================

# 普通场景保持 false。不要把企业 CA 填入 MODEL_CLIENT_CERT_FILE。
MODEL_MTLS_ENABLED=false
MODEL_CLIENT_CERT_FILE=
MODEL_CLIENT_KEY_FILE=
MODEL_CLIENT_KEY_PASSWORD=

# 是否读取 HTTP_PROXY、HTTPS_PROXY、NO_PROXY 等环境变量。
MODEL_TRUST_ENV=true

JOB_DB_PATH=data/jobs.db
WORKER_CONCURRENCY=2
JOB_POLL_INTERVAL_MS=2000

MAX_ROWS=300
MAX_COLUMNS=40
MAX_CELL_CHARS=4000
MAX_CONTEXT_CHARS=120000

ALLOWED_ORIGINS=https://your-yonghong.example.com,https://127.0.0.1:8443
